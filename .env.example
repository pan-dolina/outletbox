# ---------------------------------------------------------------------------
# outletbox configuration (copy to .env). No secrets are included here.
# Sizes accept plain bytes or suffixes: 100MB, 2GB, 512KiB (MB = MiB here).
# ---------------------------------------------------------------------------

# Public base URL of this instance, as seen by recipients. Used to build the
# delivery links that go out by e-mail. Must include scheme. No trailing slash.
PUBLIC_URL=http://localhost:3000

# Listen address.
HOST=0.0.0.0
PORT=3000

# Behind a reverse proxy set the number of proxy hops (usually 1) or a list of
# proxy addresses/CIDRs, so client IPs come from X-Forwarded-For for rate
# limiting and the audit log. "true" is refused: it would let clients forge IPs.
TRUST_PROXY=false

# Where the SQLite database (and, for the local backend, files) live.
DATA_DIR=./data

# ---- Mail -----------------------------------------------------------------
# How the one-time codes are sent. That is the only message this application
# sends: the delivery link itself is handed to the recipient by an administrator.
#   log   - nothing leaves the machine; the message is written to the log (default)
#   smtp  - classic SMTP relay / submission
#   graph - Microsoft 365 via Graph API with an app-only OAuth token
#   ses   - Amazon SES v2
MAIL_DRIVER=log
# Envelope sender. Required for every driver except "log".
MAIL_FROM=outletbox@example.com
# Display name; defaults to BRAND_NAME.
#MAIL_FROM_NAME=Example Ltd
#MAIL_REPLY_TO=office@example.com

# --- SMTP ---
#SMTP_HOST=smtp.example.com
# 587 = submission with STARTTLS (default), 465 = implicit TLS, 25 = internal relay.
#SMTP_PORT=587
# Defaults to true for port 465.
#SMTP_SECURE=false
# Refuse to send if STARTTLS is unavailable (default true). Keep it on.
#SMTP_REQUIRE_TLS=true
#SMTP_USER=outletbox@example.com
#SMTP_PASSWORD=
# Only for an internal relay with a self-signed certificate.
#SMTP_ALLOW_INSECURE_TLS=false

# --- Microsoft 365 (Graph, client credentials) ---
# App registration with the APPLICATION permission Mail.Send (admin consent).
# Restrict it to the one mailbox with an application access policy, otherwise
# the app may send as any user in the tenant.
#GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
#GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
#GRAPH_CLIENT_SECRET=
# Mailbox to send as (UPN or object id); defaults to MAIL_FROM.
#GRAPH_SENDER=outletbox@example.com
#GRAPH_SAVE_TO_SENT_ITEMS=false
# Sovereign clouds only.
#GRAPH_AUTHORITY=https://login.microsoftonline.com
#GRAPH_API_BASE=https://graph.microsoft.com/v1.0

# --- Amazon SES (v2) ---
#SES_REGION=eu-central-1
# Omit the keys to use the instance role / default AWS credential chain.
#SES_ACCESS_KEY_ID=
#SES_SECRET_ACCESS_KEY=
#SES_CONFIGURATION_SET=
#SES_ENDPOINT=

# ---- Storage -------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
# Local backend: directory for file objects (defaults to $DATA_DIR/files).
# Keep it outside any web-served directory.
#LOCAL_STORAGE_DIR=./data/files

# S3 / S3-compatible backend (MinIO, Ceph RGW, ...). The bucket must be private.
#S3_ENDPOINT=http://minio:9000
#S3_REGION=us-east-1
#S3_BUCKET=outletbox
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# Required for MinIO and most self-hosted S3 implementations.
#S3_FORCE_PATH_STYLE=true
# Multipart part size for resumable uploads (min 5MB).
#S3_PART_SIZE=8MB

# ---- Limits ---------------------------------------------------------------
# Maximum size of a single file an administrator can upload.
MAX_FILE_SIZE=10GB
# Browser upload chunk size (tus PATCH request size). Larger = fewer requests,
# smaller = finer-grained resume. Must be below any reverse proxy body limit.
UPLOAD_CHUNK_SIZE=32MB

# ---- Recipient unlock -------------------------------------------------------
# How long a one-time code stays valid.
ACCESS_CODE_TTL_MINUTES=15
# How long a recipient stays unlocked after entering a valid code.
ACCESS_SESSION_TTL_MINUTES=60
# Wrong codes for one challenge before it is destroyed and a new one is needed.
MAX_CODE_ATTEMPTS=5
# Codes that may be requested for a single link per hour (anti mail-bombing).
CHALLENGE_LIMIT_PER_LINK_PER_HOUR=5

# ---- Housekeeping -----------------------------------------------------------
# Unfinished uploads older than this are deleted (storage + metadata).
INCOMPLETE_UPLOAD_TTL_HOURS=24
# How often the cleanup job runs inside the app process. 0 disables it.
CLEANUP_INTERVAL_MINUTES=30

# ---- Admin sessions ---------------------------------------------------------
SESSION_TTL_HOURS=12
# Require every admin to enrol a TOTP authenticator app before using the panel.
# Recommended for internet-facing instances. Admins can also enable it themselves.
ADMIN_REQUIRE_TOTP=false
# Defaults to true when PUBLIC_URL starts with https://. Set to false only for
# plain-HTTP local development.
#COOKIE_SECURE=true

# ---- Rate limiting (per client IP) ----------------------------------------
LOGIN_RATE_LIMIT_PER_15MIN=10
# Failed token lookups and failed unlock attempts per IP per 15 minutes.
TOKEN_FAILURE_RATE_LIMIT_PER_15MIN=30
# General public requests per IP per minute.
PUBLIC_RATE_LIMIT_PER_MINUTE=600

# debug | info | warn | error
LOG_LEVEL=info

# ---- Branding -----------------------------------------------------------------
# Shown to recipients and admins: page titles, top bar, footer, e-mails, TOTP issuer.
#BRAND_NAME=outletbox
# Logo file (png/svg/jpg/webp) served at /brand/logo; mount it into the container
# and keep it outside the repository. The top bar shows the logo instead of the name.
#BRAND_LOGO_PATH=./branding/logo.png
# Colours (hex). Primary = buttons/links, topbar = header background, accent = highlights.
# Quote the values: an unquoted "#" starts a comment in .env files.
#BRAND_COLOR_PRIMARY="#1f6feb"
#BRAND_COLOR_TOPBAR="#101418"
#BRAND_COLOR_ACCENT="#1f6feb"
#BRAND_FOOTER_TEXT=
